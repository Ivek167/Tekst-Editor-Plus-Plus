{
  "$schema": "https://tauri.app",
  "productName": "Tekst-Editor-Plus-Plus",
  "version": "0.1.0",
  "identifier": "hr.vaseime.teksteditorplusplus",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tekst-Editor-Plus-Plus",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vaše Ime",
    "copyright": "Copyright © 2026 Vaše Ime",
    "shortDescription": "Prijenosni uređivač teksta",
    "longDescription": "Prijenosni uređivač teksta s podrškom za isticanje sintakse.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
